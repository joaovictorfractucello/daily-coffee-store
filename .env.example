# Copie este arquivo para .env e preencha. Não coloque segredos aqui: tudo que começa
# com NEXT_PUBLIC_ vai para o navegador.

# URL do mapa do Google Maps.
# Como pegar: Google Maps > procure o endereço > Compartilhar > Incorporar um mapa >
# copie só o endereço que está dentro de src="..." (começa com https://www.google.com/maps/embed).
# Vazio ou inválido: a página mostra o bloco "O mapa aparece aqui".
NEXT_PUBLIC_MAP_EMBED_URL=

# Banco (Neon). No painel do Neon: Connect > escolha a branch > Connection string.
# Local e staging usam a branch "dev"; produção usa a "production" (configurada na Vercel).
# Nunca use a URL da production no seu .env local.

# URL com pooler (o host tem "-pooler"): usada pela aplicação.
DATABASE_URL=
# URL direta (sem "-pooler"): usada só pelo Prisma CLI nas migrations.
DIRECT_URL=
