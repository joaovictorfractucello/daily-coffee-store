# Copie este arquivo para .env e preencha. Não coloque segredos aqui: tudo que começa
# com NEXT_PUBLIC_ vai para o navegador.

# URL do mapa do Google Maps.
# Como pegar: Google Maps > procure o endereço > Compartilhar > Incorporar um mapa >
# copie só o endereço que está dentro de src="..." (começa com https://www.google.com/maps/embed).
# Vazio ou inválido: a página mostra o bloco "O mapa aparece aqui".
NEXT_PUBLIC_MAP_EMBED_URL=

# Banco (Neon). No painel do Neon: Connect > escolha a branch > Connection string.
# Local e staging usam a branch "dev"; produção usa a "production" (configurada na Vercel).
# Nunca use a URL da production no seu .env local.

# URL com pooler (o host tem "-pooler"): usada pela aplicação.
DATABASE_URL=
# URL direta (sem "-pooler"): usada só pelo Prisma CLI nas migrations.
DIRECT_URL=

# VERCEL_ENV é definida pela própria Vercel (production ou preview). Não coloque no .env:
# sem ela, o site roda como não produção (noindex e robots bloqueando tudo).

# Endereço do site usado nos links dos e-mails (sem barra no fim). Local: http://localhost:3000.
# Na Vercel: a URL do staging no ambiente Preview e a da produção no Production.
APP_URL=http://localhost:3000

# Gmail que envia os e-mails (verificação de cadastro e recuperação de senha).
# GMAIL_APP_PASSWORD é uma "senha de app", não a senha da conta: Conta Google > Segurança >
# Verificação em duas etapas (precisa estar ativa) > Senhas de app.
# Local: se ficarem vazias, o e-mail aparece no terminal do `npm run dev` em vez de ser enviado.
# Na Vercel são obrigatórias (sem elas o build falha).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Login com Google: Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth
# (Aplicativo da Web). Redirect URI autorizado: <APP_URL>/api/auth/google/callback, um para cada
# ambiente (localhost, staging, produção).
# Local: se ficarem vazias, o botão do Google volta para o login com aviso de indisponível.
# Na Vercel são obrigatórias (sem elas o build falha).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
