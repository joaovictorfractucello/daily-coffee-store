generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  DEMO_ADMIN
}

enum EmailTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            Role      @default(CUSTOMER)
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions      Session[]
  oauthAccounts OAuthAccount[]
  emailTokens   EmailToken[]
  addresses     Address[]
}

// O id é o SHA-256 do token que vai no cookie: o banco nunca guarda o token em si.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model EmailToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  userId    String
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Limite de tentativas (ADR 011). A chave guarda só hashes, nunca IP ou e-mail em texto.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Apelido do endereço, como nos apps de entrega: define o ícone e o título na lista.
enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum ProductCategory {
  CAFES
  BEBIDAS_GELADAS
  SALGADOS
  DOCES
}

model Product {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  description  String
  priceInCents Int
  imageUrl     String
  category     ProductCategory
  isActive     Boolean         @default(true)
  isFeatured   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive, category])
}

// Cidades atendidas e taxa de entrega (ADR 012). Desativar em vez de apagar: endereços apontam para elas.
model DeliveryCity {
  id                 String   @id @default(cuid())
  name               String
  state              String
  deliveryFeeInCents Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  addresses Address[]

  @@unique([name, state])
}

// Endereços salvos do cliente. Bairro, cidade e UF como vieram do ViaCEP; a cidade atendida define a taxa.
model Address {
  id               String       @id @default(cuid())
  userId           String
  cep              String
  street           String
  number           String
  complement       String?
  neighborhoodName String
  city             String
  state            String
  deliveryCityId   String
  label            AddressLabel @default(OTHER)
  // Nome livre, só quando label = OTHER (ex.: "Casa da mãe").
  customLabel      String?
  isDefault        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryCity DeliveryCity @relation(fields: [deliveryCityId], references: [id])

  @@index([userId])
}
