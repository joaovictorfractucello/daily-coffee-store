              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Cria a conta e manda o link de confirmação. O campo role é descartado (sem mass assignment).",
