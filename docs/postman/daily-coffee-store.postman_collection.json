                  "const body = pm.response.json();",
                  "pm.test(\"id inexistente volta em unavailableProductIds\", () => pm.expect(body.unavailableProductIds).to.eql([\"cmhy1n2xk0000abcd1234efgh\"]));",
                  "pm.test(\"só o produto ativo entra no subtotal\", () => pm.expect(body.items).to.have.lengthOf(1));"
                ]
              }
