    {
      "name": "Carrinho",
      "description": "Confere o carrinho do navegador: recebe só ids e quantidades e calcula tudo com os preços do banco.",
      "item": [
        {
          "name": "POST /cart/quote",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Os ids mudam entre bancos: busca o id do Espresso antes de montar o carrinho.",
                  "pm.sendRequest(pm.variables.replaceIn(\"{{baseUrl}}/products/espresso\"), (error, response) => {",
                  "  if (error) throw error;",
                  "  const espresso = response.json();",
                  "  pm.variables.set(\"espressoId\", espresso.id);",
                  "  pm.variables.set(\"espressoPrice\", espresso.priceInCents);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const price = Number(pm.variables.get(\"espressoPrice\"));",
                  "pm.test(\"total do item com o preço do banco\", () => { pm.expect(body.items[0].quantity).to.equal(2); pm.expect(body.items[0].lineTotalInCents).to.equal(price * 2); });",
                  "pm.test(\"subtotal calculado no servidor\", () => pm.expect(body.subtotalInCents).to.equal(price * 2));",
                  "pm.test(\"produto público, sem isActive\", () => pm.expect(body.items[0].product).to.not.have.property(\"isActive\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"productId\": \"{{espressoId}}\", \"quantity\": 2 }]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "quote"
              ]
            },
            "description": "Carrinho válido. Resposta: itens com o produto público, quantidade e total do item; ids indisponíveis; subtotal."
          }
        },
