    {
      "name": "Autenticação",
      "description": "Cadastro, verificação, login, sessão e logout. O Postman guarda o cookie __Host-session sozinho depois do login. Para confirmar o e-mail, copie o token do link (terminal do npm run dev ou e-mail) para a variável verifyToken. Variáveis authEmail e authPassword: uma conta já confirmada.",
      "item": [
        {
          "name": "POST /auth/register (e-mail novo)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"newEmail\", `teste.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"resposta sem detalhes da conta\", () => pm.expect(pm.response.json()).to.eql({ ok: true }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
